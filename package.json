{
    "dependencies": {
        "http-errors": "~2.0.0",
        "memory-cache": "~0.2.0",
        "request": "~2.88.0"
    },
    "description": "The DHL ECOMMERCE SOLUTIONS AMERICAS API is your one stop solution to get shipping products, calculating duty and tax, generating shipping labels, manifesting packages, requesting shipment pickup, tracking packages and generating return labels.",
    "devDependencies": {
        "@eslint/js": "*",
        "globals": "*"
    },
    "keywords": [
        "logistics",
        "dhl",
        "shipping",
        "tracking",
        "zpl"
    ],
    "license": "MIT",
    "name": "dhl-ecommerce-solutions",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stores-com/dhl-ecommerce-solutions.git"
    },
    "scripts": {
        "coveralls": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info test && coveralls < lcov.info",
        "test": "node --test --test-force-exit test",
        "test:only": "node --test --test-force-exit --test-only test"
    },
    "version": "0.4.0"
